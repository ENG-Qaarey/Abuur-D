{
	"$schema": "node_modules/wrangler/config-schema.json",
	// ABUUR API on Cloudflare Workers. Node.js entry stays src/index.ts (npm run dev / npm start).
	"name": "abuur-api",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": { "enabled": true },
	"alias": {
		// PDFKit's self-contained build embeds its fonts (the Node build reads them from disk)
		"pdfkit": "./node_modules/pdfkit/js/pdfkit.standalone.js"
	},
	"triggers": {
		// every minute: notifications, campaigns, automations | every 10 min: invoices, subscriptions,
		// recurring entries, reminders | daily 03:00 UTC: inactivity check
		"crons": ["* * * * *", "*/10 * * * *", "0 3 * * *"]
	},
	// Non-secret settings (the Supabase publishable key is public). Secrets (DATABASE_URL, DIRECT_URL,
	// JWT_SECRET, SUPABASE_SECRET_KEY, CREDENTIALS_KEY) are set in the Cloudflare dashboard, never here.
	"vars": {
		"NODE_ENV": "production",
		"API_PREFIX": "api",
		"JWT_EXPIRES_IN": "7d",
		"CORS_ORIGIN": "https://abuur-d.muscabaxmed762.workers.dev",
		"SITE_URL": "https://abuur-d.muscabaxmed762.workers.dev",
		"PUBLIC_API_URL": "https://abuur-api.muscabaxmed762.workers.dev/api",
		"SUPABASE_URL": "https://xlwmxjrymlugpdzmcmew.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Xx8hZlQ_p-sZA8cre6G9VA_4aK_feh7",
		"SUPABASE_JWKS_URL": "https://xlwmxjrymlugpdzmcmew.supabase.co/auth/v1/.well-known/jwks.json",
		"STORAGE_DRIVER": "supabase",
		"STORAGE_BUCKET": "abuur-private",
		"MAX_UPLOAD_MB": "25",
		"DB_POOL_MAX": "3"
	},
	"keep_vars": true
}
