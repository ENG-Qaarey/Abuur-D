/// Generated by Prisma schema to NestJS implementation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: Supabase transaction pooler (port 6543, ?pgbouncer=true)
  url       = env("DATABASE_URL")
  // Migrations: session pooler (port 5432); pgbouncer transaction mode can't run them
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PlatformRole {
  USER
  ABUUR_STAFF
  SUPER_ADMIN
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum BillingRecordStatus {
  PENDING
  PAID
  VOID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CreativeRequestStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ORDER
  PAYMENT
  SUBSCRIPTION
  CREATIVE
  MARKETING
}

enum FileCategory {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum IntegrationProvider {
  WHATSAPP
  SMS
  EMAIL
  PAYMENT
  STORAGE
  OTHER
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

// ============================================================
// AUTHENTICATION AND USERS
// Authentication is handled by Supabase Auth.
// Store the Supabase user ID here; do not store passwords.
// ============================================================

model User {
  id                     String                @id @default(uuid()) @db.Uuid
  managedClients         CRMCustomer[]         @relation("ClientAccountManager")
  clientCommunications   ClientCommunication[] @relation("CommunicationAuthor")
  managedProjects        CreativeProject[]     @relation("ProjectManager")
  creativeReviews        CreativeReview[]      @relation("CreativeReviewer")
  verifiedSuppliers      SupplierProfile[]     @relation("SupplierVerifier")
  reviewedSupplierDocs   SupplierDocument[]    @relation("SupplierDocumentReviewer")
  productImports         ProductImportJob[]    @relation("ProductImportCreator")
  handledContactMessages ContactMessage[]      @relation("ContactHandler")
  /// Set for users who sign in through Supabase Auth; null for local (email + password) users.
  supabaseId             String?               @unique
  /// scrypt hash for local email + password login (see src/auth/password.ts). Never returned by the API.
  passwordHash           String?
  email                  String?               @unique
  phone                  String?               @unique
  firstName              String?
  lastName               String?
  avatarUrl              String?
  status                 UserStatus            @default(ACTIVE)
  platformRole           PlatformRole          @default(USER)
  emailVerified          Boolean               @default(false)
  phoneVerified          Boolean               @default(false)

  memberships        BusinessMembership[]
  createdStores      Store[]                     @relation("StoreCreator")
  recordedBillings   SubscriptionBillingRecord[] @relation("BillingRecorder")
  orderStatusChanges StoreOrderStatusEvent[]
  createdLeads       Lead[]                      @relation("LeadCreator")
  assignedTasks      CreativeTask[]              @relation("TaskAssignee")
  createdRequests    CreativeRequest[]           @relation("RequestCreator")
  financeEntries     FinanceTransaction[]        @relation("FinanceCreator")
  notifications      Notification[]
  uploadedFiles      FileAsset[]
  auditLogs          AuditLog[]
  storeCustomers     StoreCustomer[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([status])
  @@map("users")
}

// ============================================================
// BUSINESSES AND MULTI-TENANCY
// Every business-owned record must be scoped to its business.
// ============================================================

model Business {
  id                   String                @id @default(uuid()) @db.Uuid
  clientOnboardings    ClientOnboarding[]
  servicePackages      ServicePackage[]
  clientSubscriptions  ClientSubscription[]
  clientCommunications ClientCommunication[]
  creativeDeliverables CreativeDeliverable[]
  whatsappAccounts     WhatsAppAccount[]
  contactSegments      ContactSegment[]
  messageTemplates     MessageTemplate[]
  automationRules      AutomationRule[]
  autoReplies          AutoReply[]
  chatbotFlows         ChatbotFlow[]
  messageLogs          MessageLog[]
  supplierProfile      SupplierProfile?
  resellerProfile      ResellerProfile?
  name                 String
  slug                 String                @unique
  description          String?
  logoUrl              String?
  email                String?
  phone                String?
  address              String?
  industry             String?
  status               BusinessStatus        @default(PENDING_APPROVAL)
  settings             Json?

  memberships       BusinessMembership[]
  subscriptions     Subscription[]
  billingRecords    SubscriptionBillingRecord[]
  stores            Store[]
  crmCustomers      CRMCustomer[]
  leads             Lead[]
  creativeRequests  CreativeRequest[]
  creativeProjects  CreativeProject[]
  marketingContacts MarketingContact[]
  campaigns         Campaign[]
  financeEntries    FinanceTransaction[]
  invoices          Invoice[]
  payments          Payment[]
  integrations      IntegrationConnection[]
  files             FileAsset[]
  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([industry])
  @@map("businesses")
}

model BusinessMembership {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  businessId String           @db.Uuid
  role       MembershipRole   @default(EMPLOYEE)
  status     MembershipStatus @default(INVITED)
  invitedAt  DateTime?
  joinedAt   DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([businessId, status])
  @@map("business_memberships")
}

// ============================================================
// SUBSCRIPTIONS AND PLANS
// A business subscribes to an ABUUR plan. Billing records are kept
// without an online payment gateway (payments happen off-platform).
// ============================================================

model Plan {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  description String?
  price       Decimal         @db.Decimal(12, 2)
  currency    String          @default("USD")
  interval    BillingInterval @default(MONTHLY)
  features    Json?
  limits      Json?
  isActive    Boolean         @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  planId                 String             @db.Uuid
  businessId             String             @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  startDate              DateTime           @default(now())
  endDate                DateTime?
  trialEndsAt            DateTime?
  nextBillingAt          DateTime?
  cancelledAt            DateTime?
  externalSubscriptionId String?
  metadata               Json?

  plan           Plan                        @relation(fields: [planId], references: [id])
  business       Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  billingRecords SubscriptionBillingRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([nextBillingAt])
  @@map("subscriptions")
}

/// One billing period of an ABUUR subscription. Recorded by ABUUR staff when
/// the business pays off-platform (e.g. mobile money); no gateway involved.
model SubscriptionBillingRecord {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @db.Uuid
  businessId     String              @db.Uuid
  amount         Decimal             @db.Decimal(12, 2)
  currency       String              @default("USD")
  periodStart    DateTime
  periodEnd      DateTime
  status         BillingRecordStatus @default(PENDING)
  method         String?
  reference      String?
  notes          String?
  recordedById   String?             @db.Uuid
  paidAt         DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("BillingRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, periodStart])
  @@index([businessId, status])
  @@map("subscription_billing_records")
}

// ============================================================
// CRM
// ============================================================

model CRMCustomer {
  id               String                @id @default(uuid()) @db.Uuid
  status           ClientStatus          @default(LEAD)
  contactPerson    String?
  whatsappNumber   String?
  industry         String?
  website          String?
  city             String?
  country          String?
  socialLinks      Json?
  tags             String[]
  accountManagerId String?               @db.Uuid
  onboardedAt      DateTime?
  accountManager   User?                 @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  onboarding       ClientOnboarding?
  subscriptions    ClientSubscription[]
  communications   ClientCommunication[]
  projects         CreativeProject[]
  creativeRequests CreativeRequest[]
  businessId       String                @db.Uuid
  name             String
  email            String?
  phone            String?
  company          String?
  address          String?
  notes            String?
  metadata         Json?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads    Lead[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("crm_customers")
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  businessId        String     @db.Uuid
  customerId        String?    @db.Uuid
  createdById       String?    @db.Uuid
  title             String
  description       String?
  source            String?
  status            LeadStatus @default(NEW)
  value             Decimal?   @db.Decimal(12, 2)
  currency          String     @default("USD")
  expectedCloseDate DateTime?
  notes             String?

  business  Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  CRMCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@map("leads")
}

// ============================================================
// CREATIVE PRODUCTION
// ============================================================

model CreativeRequest {
  id             String                @id @default(uuid()) @db.Uuid
  customerId     String?               @db.Uuid
  /// Brief: what the client wants to achieve and where it will be published.
  objective      String?
  targetAudience String?
  platforms      String[]
  customer       CRMCustomer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId     String                @db.Uuid
  createdById    String                @db.Uuid
  title          String
  description    String?
  serviceType    String?
  requirements   Json?
  deadline       DateTime?
  status         CreativeRequestStatus @default(SUBMITTED)

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User             @relation("RequestCreator", fields: [createdById], references: [id])
  project   CreativeProject?
  reviews   CreativeReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@map("creative_requests")
}

model CreativeProject {
  id                   String                @id @default(uuid()) @db.Uuid
  customerId           String?               @db.Uuid
  clientSubscriptionId String?               @db.Uuid
  managerId            String?               @db.Uuid
  stage                ProductionStage       @default(BRIEF)
  customer             CRMCustomer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientSubscription   ClientSubscription?   @relation(fields: [clientSubscriptionId], references: [id], onDelete: SetNull)
  manager              User?                 @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  deliverables         CreativeDeliverable[]
  reviews              CreativeReview[]
  businessId           String                @db.Uuid
  requestId            String?               @unique @db.Uuid
  title                String
  description          String?
  status               ProjectStatus         @default(PLANNING)
  startDate            DateTime?
  deadline             DateTime?
  completedAt          DateTime?

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  request  CreativeRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  tasks    CreativeTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@map("creative_projects")
}

model CreativeTask {
  id             String          @id @default(uuid()) @db.Uuid
  stage          ProductionStage @default(BRIEF)
  estimatedHours Decimal?        @db.Decimal(6, 2)
  projectId      String          @db.Uuid
  assignedToId   String?         @db.Uuid
  title          String
  description    String?
  status         TaskStatus      @default(TODO)
  priority       Int             @default(3)
  deadline       DateTime?
  completedAt    DateTime?

  project    CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([assignedToId, status])
  @@map("creative_tasks")
}

model CreativeReview {
  id            String               @id @default(uuid()) @db.Uuid
  projectId     String?              @db.Uuid
  deliverableId String?              @db.Uuid
  reviewedById  String?              @db.Uuid
  /// Name of the client-side reviewer when they have no ABUUR account.
  reviewerName  String?
  project       CreativeProject?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable   CreativeDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  reviewedBy    User?                @relation("CreativeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  requestId     String?              @db.Uuid
  status        ApprovalStatus       @default(PENDING)
  feedback      String?
  version       Int                  @default(1)
  reviewedAt    DateTime?

  request CreativeRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([requestId, status])
  @@map("creative_reviews")
}

// ============================================================
// WHATSAPP MARKETING AND SMS
// ============================================================

model MarketingContact {
  id              String                 @id @default(uuid()) @db.Uuid
  whatsappOptInAt DateTime?
  segmentMembers  ContactSegmentMember[]
  consentEvents   ContactConsentEvent[]
  messageLogs     MessageLog[]
  businessId      String                 @db.Uuid
  name            String?
  phone           String?
  email           String?
  tags            String[]
  whatsappConsent Boolean                @default(false)
  smsConsent      Boolean                @default(false)
  emailConsent    Boolean                @default(false)
  optedOutAt      DateTime?
  metadata        Json?

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("marketing_contacts")
}

model Campaign {
  id                String           @id @default(uuid()) @db.Uuid
  segmentId         String?          @db.Uuid
  templateId        String?          @db.Uuid
  whatsappAccountId String?          @db.Uuid
  /// Values for the template variables, e.g. {"1":"Hodan"}.
  templateParams    Json?
  /// SMS sender ID / name shown to recipients.
  senderId          String?
  /// Cached analytics, updated from message logs.
  totalRecipients   Int              @default(0)
  sentCount         Int              @default(0)
  deliveredCount    Int              @default(0)
  readCount         Int              @default(0)
  failedCount       Int              @default(0)
  replyCount        Int              @default(0)
  clickCount        Int              @default(0)
  segment           ContactSegment?  @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  template          MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  messageLogs       MessageLog[]
  businessId        String           @db.Uuid
  name              String
  description       String?
  channel           CampaignChannel
  status            CampaignStatus   @default(DRAFT)
  message           String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  metadata          Json?

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id                String        @id @default(uuid()) @db.Uuid
  readAt            DateTime?
  failedAt          DateTime?
  repliedAt         DateTime?
  clickedAt         DateTime?
  campaignId        String        @db.Uuid
  contactId         String        @db.Uuid
  status            MessageStatus @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  error             String?

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ============================================================
// WHATSAPP STORE AND E-COMMERCE
// Integrated and standalone stores use this same data model.
// businessId is nullable for standalone stores.
// ============================================================

model Store {
  id               String            @id @default(uuid()) @db.Uuid
  resellerProducts ResellerProduct[]
  promotionLinks   PromotionLink[]
  businessId       String            @db.Uuid
  createdById      String            @db.Uuid
  name             String
  slug             String            @unique
  description      String?
  logoUrl          String?
  /// E.164 number that receives WhatsApp orders. Required before the store goes ACTIVE.
  whatsappNumber   String?
  phone            String?
  email            String?
  address          String?
  city             String?
  status           StoreStatus       @default(DRAFT)
  currency         String            @default("USD")
  settings         Json?

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy  User                @relation("StoreCreator", fields: [createdById], references: [id])
  products   Product[]
  categories ProductCategory[]
  inventory  InventoryMovement[]
  customers  StoreCustomer[]
  orders     StoreOrder[]
  domains    StoreDomain[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([businessId])
  @@index([status])
  @@map("stores")
}

model StoreDomain {
  id         String    @id @default(uuid()) @db.Uuid
  storeId    String    @db.Uuid
  domain     String    @unique
  isPrimary  Boolean   @default(false)
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storeId])
  @@map("store_domains")
}

model ProductCategory {
  id          String  @id @default(uuid()) @db.Uuid
  storeId     String  @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int     @default(0)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("product_categories")
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  /// Set when this store product is a reseller listing of a supplier product.
  resellerListing ResellerProduct?
  storeId         String           @db.Uuid
  categoryId      String?          @db.Uuid
  name            String
  slug            String
  description     String?
  sku             String?
  price           Decimal          @db.Decimal(12, 2)
  compareAtPrice  Decimal?         @db.Decimal(12, 2)
  currency        String           @default("USD")
  stock           Int              @default(0)
  status          ProductStatus    @default(DRAFT)
  images          Json?
  metadata        Json?

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems StoreOrderItem[]
  movements  InventoryMovement[]
  variants   ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId, status])
  @@index([categoryId])
  @@map("products")
}

/// A sellable variation of a product, e.g. size M / colour red.
model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  name      String
  /// e.g. {"size":"M","color":"Red"}
  options   Json
  sku       String?
  /// Overrides Product.price when set.
  price     Decimal? @db.Decimal(12, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems StoreOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model InventoryMovement {
  id          String  @id @default(uuid()) @db.Uuid
  storeId     String  @db.Uuid
  productId   String  @db.Uuid
  quantity    Int
  reason      String
  referenceId String?
  notes       String?

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model StoreCustomer {
  id       String  @id @default(uuid()) @db.Uuid
  storeId  String  @db.Uuid
  userId   String? @db.Uuid
  name     String
  phone    String?
  email    String?
  address  String?
  metadata Json?

  store  Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders StoreOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, phone])
  @@index([storeId, email])
  @@map("store_customers")
}

model StoreOrder {
  id                String               @id @default(uuid()) @db.Uuid
  resellerId        String?              @db.Uuid
  promotionLinkId   String?              @db.Uuid
  referralCode      String?
  reseller          ResellerProfile?     @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  promotionLink     PromotionLink?       @relation(fields: [promotionLinkId], references: [id], onDelete: SetNull)
  fulfillments      OrderFulfillment[]
  commissions       ResellerCommission[]
  messageLogs       MessageLog[]
  storeId           String               @db.Uuid
  customerId        String?              @db.Uuid
  orderNumber       String
  status            OrderStatus          @default(NEW)
  paymentStatus     PaymentStatus        @default(PENDING)
  subtotal          Decimal              @db.Decimal(12, 2)
  discount          Decimal              @default(0) @db.Decimal(12, 2)
  shippingCost      Decimal              @default(0) @db.Decimal(12, 2)
  total             Decimal              @db.Decimal(12, 2)
  currency          String               @default("USD")
  customerName      String?
  customerPhone     String?
  customerAddress   String?
  notes             String?
  /// How the customer agreed to pay, recorded by staff (e.g. "EVC Plus", "cash on delivery").
  paymentMethod     String?
  paymentNote       String?
  whatsappHandoffAt DateTime?
  metadata          Json?

  store        Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     StoreCustomer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        StoreOrderItem[]
  statusEvents StoreOrderStatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@map("store_orders")
}

model StoreOrderItem {
  id                String            @id @default(uuid()) @db.Uuid
  /// Dropshipping: which supplier product this line came from, and at what wholesale price.
  supplierProductId String?           @db.Uuid
  fulfillmentId     String?           @db.Uuid
  wholesalePrice    Decimal?          @db.Decimal(12, 2)
  supplierProduct   SupplierProduct?  @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  fulfillment       OrderFulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)
  orderId           String            @db.Uuid
  productId         String?           @db.Uuid
  variantId         String?           @db.Uuid
  productName       String
  variantName       String?
  sku               String?
  quantity          Int
  unitPrice         Decimal           @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)

  order   StoreOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("store_order_items")
}

/// Order tracking: one row per status change.
model StoreOrderStatusEvent {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?      @db.Uuid

  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("store_order_status_events")
}

// ============================================================
// FINANCE
// Business finance is separate from ABUUR's internal finances.
// ============================================================

model FinanceTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  businessId      String          @db.Uuid
  createdById     String?         @db.Uuid
  type            TransactionType
  category        String
  description     String?
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  reference       String?
  transactionDate DateTime        @default(now())
  metadata        Json?

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("FinanceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, type])
  @@index([businessId, transactionDate])
  @@map("finance_transactions")
}

model Invoice {
  id                   String              @id @default(uuid()) @db.Uuid
  /// Set when the invoice bills a client service subscription (renewals).
  clientSubscriptionId String?             @db.Uuid
  clientSubscription   ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id], onDelete: SetNull)
  businessId           String              @db.Uuid
  customerId           String?             @db.Uuid
  invoiceNumber        String
  status               InvoiceStatus       @default(DRAFT)
  subtotal             Decimal             @db.Decimal(12, 2)
  tax                  Decimal             @default(0) @db.Decimal(12, 2)
  discount             Decimal             @default(0) @db.Decimal(12, 2)
  total                Decimal             @db.Decimal(12, 2)
  amountPaid           Decimal             @default(0) @db.Decimal(12, 2)
  currency             String              @default("USD")
  dueDate              DateTime?
  issuedAt             DateTime?
  notes                String?

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CRMCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  businessId String        @db.Uuid
  invoiceId  String?       @db.Uuid
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("USD")
  status     PaymentStatus @default(PENDING)
  method     String?
  provider   String?
  reference  String?
  paidAt     DateTime?
  metadata   Json?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([invoiceId])
  @@map("payments")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  actionUrl String?
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================
// FILES AND MEDIA
// File bytes live in Supabase Storage, not PostgreSQL.
// ============================================================

model FileAsset {
  id                String                @id @default(uuid()) @db.Uuid
  deliverables      CreativeDeliverable[]
  supplierDocuments SupplierDocument[]
  productImports    ProductImportJob[]
  businessId        String?               @db.Uuid
  uploadedById      String                @db.Uuid
  name              String
  originalName      String
  mimeType          String
  category          FileCategory          @default(OTHER)
  size              BigInt
  storagePath       String
  bucket            String
  isPublic          Boolean               @default(false)
  metadata          Json?

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, category])
  @@index([uploadedById])
  @@map("file_assets")
}

// ============================================================
// EXTERNAL INTEGRATIONS
// Store secrets securely; never return credentials to clients.
// ============================================================

model IntegrationConnection {
  id                String              @id @default(uuid()) @db.Uuid
  whatsappAccounts  WhatsAppAccount[]
  businessId        String              @db.Uuid
  provider          IntegrationProvider
  name              String
  status            IntegrationStatus   @default(DISCONNECTED)
  externalAccountId String?
  credentials       Json?
  settings          Json?
  connectedAt       DateTime?
  lastError         String?

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  webhookEvents WebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, provider])
  @@map("integration_connections")
}

// ============================================================
// WEBHOOK EVENTS
// Store incoming events for reliable and idempotent processing.
// ============================================================

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  integrationId   String?       @db.Uuid
  provider        String
  externalEventId String?
  eventType       String
  payload         Json
  status          WebhookStatus @default(PENDING)
  attempts        Int           @default(0)
  processedAt     DateTime?
  error           String?

  integration IntegrationConnection? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
  @@map("webhook_events")
}

// ============================================================
// AUDIT LOGS
// Track sensitive administrative and business actions.
// ============================================================

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  businessId String? @db.Uuid
  userId     String? @db.Uuid
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================
// CRM, CLIENT SERVICES AND CREATIVE PRODUCTION
// Clients of a business (CRMCustomer) buy service packages,
// get onboarded, and receive creative work through projects.
// ============================================================

enum ClientStatus {
  LEAD
  ONBOARDING
  ACTIVE
  AT_RISK
  CHURNED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PackageBilling {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ClientSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum CommunicationChannel {
  CALL
  WHATSAPP
  SMS
  EMAIL
  MEETING
  NOTE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ProductionStage {
  BRIEF
  SCRIPTING
  SHOOTING
  DESIGN
  EDITING
  INTERNAL_REVIEW
  CLIENT_REVIEW
  REVISION
  DELIVERED
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  REVISION_REQUESTED
  APPROVED
  DELIVERED
}

/// Onboarding of one client: a checklist that ends with the client becoming ACTIVE.
model ClientOnboarding {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @db.Uuid
  customerId  String           @unique @db.Uuid
  status      OnboardingStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?

  business Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CRMCustomer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tasks    ClientOnboardingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@map("client_onboardings")
}

model ClientOnboardingTask {
  id           String    @id @default(uuid()) @db.Uuid
  onboardingId String    @db.Uuid
  title        String
  isDone       Boolean   @default(false)
  doneAt       DateTime?
  sortOrder    Int       @default(0)

  onboarding ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([onboardingId, sortOrder])
  @@map("client_onboarding_tasks")
}

/// A service the business sells to its clients (e.g. "Social media - 12 posts/month").
model ServicePackage {
  id           String         @id @default(uuid()) @db.Uuid
  businessId   String         @db.Uuid
  name         String
  description  String?
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("USD")
  billing      PackageBilling @default(MONTHLY)
  /// e.g. [{"item":"Instagram posts","quantity":12}]
  deliverables Json?
  /// Revisions included per deliverable; null = unlimited.
  maxRevisions Int?
  isActive     Boolean        @default(true)

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptions ClientSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, isActive])
  @@map("service_packages")
}

/// A client's subscription to a service package; drives renewals and retention.
model ClientSubscription {
  id            String                   @id @default(uuid()) @db.Uuid
  businessId    String                   @db.Uuid
  customerId    String                   @db.Uuid
  packageId     String                   @db.Uuid
  status        ClientSubscriptionStatus @default(ACTIVE)
  /// Price agreed with this client (snapshot; the package price may change later).
  price         Decimal                  @db.Decimal(12, 2)
  currency      String                   @default("USD")
  startDate     DateTime                 @default(now())
  endDate       DateTime?
  renewalDate   DateTime?
  autoRenew     Boolean                  @default(true)
  renewalCount  Int                      @default(0)
  lastRenewedAt DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  notes         String?

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CRMCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package  ServicePackage    @relation(fields: [packageId], references: [id])
  invoices Invoice[]
  projects CreativeProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([businessId, renewalDate])
  @@index([customerId])
  @@map("client_subscriptions")
}

/// Client communication history: calls, chats, emails, meetings and internal notes.
model ClientCommunication {
  id         String               @id @default(uuid()) @db.Uuid
  businessId String               @db.Uuid
  customerId String               @db.Uuid
  userId     String?              @db.Uuid
  channel    CommunicationChannel
  direction  MessageDirection     @default(OUTBOUND)
  subject    String?
  content    String
  occurredAt DateTime             @default(now())
  metadata   Json?

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CRMCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?       @relation("CommunicationAuthor", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([businessId, occurredAt])
  @@map("client_communications")
}

/// A versioned piece of work handed to the client (video, poster, script...).
/// A revision is a new version of the same title.
model CreativeDeliverable {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @db.Uuid
  projectId   String            @db.Uuid
  title       String
  version     Int               @default(1)
  status      DeliverableStatus @default(DRAFT)
  fileId      String?           @db.Uuid
  url         String?
  notes       String?
  deliveredAt DateTime?

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  CreativeProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file     FileAsset?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  reviews  CreativeReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, title, version])
  @@index([businessId, status])
  @@map("creative_deliverables")
}

// ============================================================
// WHATSAPP MARKETING AND MESSAGING
// ============================================================

enum WhatsAppAccountStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  BANNED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  OPTED_OUT
}

enum ConsentAction {
  OPT_IN
  OPT_OUT
}

enum ConsentSource {
  STOREFRONT
  FORM
  WHATSAPP_REPLY
  SMS_REPLY
  IMPORT
  MANUAL
}

enum AutomationTrigger {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  CONTACT_OPTED_IN
  KEYWORD_RECEIVED
  CLIENT_RENEWAL_DUE
  SCHEDULED
}

enum AutoReplyMatch {
  EXACT
  CONTAINS
  WELCOME
  AWAY
  FALLBACK
}

/// One WhatsApp Business phone number. A business may connect several.
model WhatsAppAccount {
  id            String                @id @default(uuid()) @db.Uuid
  businessId    String                @db.Uuid
  integrationId String?               @db.Uuid
  displayName   String
  /// E.164, e.g. +252610000000
  phoneNumber   String
  /// Provider ids (Meta Cloud API: phone number id, WhatsApp Business Account id).
  phoneNumberId String?
  wabaId        String?
  status        WhatsAppAccountStatus @default(PENDING)
  qualityRating String?
  isDefault     Boolean               @default(false)
  connectedAt   DateTime?

  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  integration  IntegrationConnection? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  templates    MessageTemplate[]
  campaigns    Campaign[]
  autoReplies  AutoReply[]
  chatbotFlows ChatbotFlow[]
  messageLogs  MessageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, phoneNumber])
  @@unique([phoneNumberId])
  @@map("whatsapp_accounts")
}

/// Audience for campaigns. Dynamic segments use `rules`; static ones list members.
model ContactSegment {
  id          String  @id @default(uuid()) @db.Uuid
  businessId  String  @db.Uuid
  name        String
  description String?
  /// e.g. {"tags":["vip"],"consent":"whatsapp","lastOrderWithinDays":90}
  rules       Json?
  isDynamic   Boolean @default(true)

  business  Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members   ContactSegmentMember[]
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@map("contact_segments")
}

model ContactSegmentMember {
  segmentId String @db.Uuid
  contactId String @db.Uuid

  segment ContactSegment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([segmentId, contactId])
  @@index([contactId])
  @@map("contact_segment_members")
}

/// Proof of consent: every opt-in / opt-out with its source and time.
model ContactConsentEvent {
  id         String          @id @default(uuid()) @db.Uuid
  contactId  String          @db.Uuid
  channel    CampaignChannel
  action     ConsentAction
  source     ConsentSource
  /// e.g. the reply text, form id or importing user.
  evidence   Json?
  occurredAt DateTime        @default(now())

  contact MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, channel, occurredAt])
  @@map("contact_consent_events")
}

/// Reusable message. WhatsApp templates must be approved by Meta before use.
model MessageTemplate {
  id                 String           @id @default(uuid()) @db.Uuid
  businessId         String           @db.Uuid
  whatsappAccountId  String?          @db.Uuid
  channel            CampaignChannel  @default(WHATSAPP)
  name               String
  language           String           @default("en")
  category           TemplateCategory @default(MARKETING)
  header             Json?
  body               String
  footer             String?
  buttons            Json?
  /// Placeholder names in order, e.g. ["customer_name","order_number"].
  variables          String[]
  status             TemplateStatus   @default(DRAFT)
  providerTemplateId String?
  rejectionReason    String?

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  campaigns       Campaign[]
  automationRules AutomationRule[]
  autoReplies     AutoReply[]
  messageLogs     MessageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, channel, name, language])
  @@index([businessId, status])
  @@map("message_templates")
}

/// Automated messaging: when `trigger` happens (and `conditions` match), send a message.
model AutomationRule {
  id           String            @id @default(uuid()) @db.Uuid
  businessId   String            @db.Uuid
  name         String
  trigger      AutomationTrigger
  /// e.g. {"toStatus":"DISPATCHED"} or {"keywords":["menu"]}
  conditions   Json?
  channel      CampaignChannel   @default(WHATSAPP)
  templateId   String?           @db.Uuid
  message      String?
  delayMinutes Int               @default(0)
  isActive     Boolean           @default(true)
  lastRunAt    DateTime?
  runCount     Int               @default(0)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template    MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messageLogs MessageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, trigger, isActive])
  @@map("automation_rules")
}

/// Keyword / welcome / away auto-replies on a WhatsApp number.
model AutoReply {
  id                String         @id @default(uuid()) @db.Uuid
  businessId        String         @db.Uuid
  whatsappAccountId String?        @db.Uuid
  name              String
  matchType         AutoReplyMatch @default(CONTAINS)
  keywords          String[]
  reply             String?
  templateId        String?        @db.Uuid
  priority          Int            @default(0)
  /// e.g. {"tz":"Africa/Mogadishu","days":[6,0,1,2,3],"from":"08:00","to":"20:00"}
  activeHours       Json?
  isActive          Boolean        @default(true)

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  template        MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, isActive, priority])
  @@map("auto_replies")
}

/// Chatbot conversation flow (menus, questions, hand-off to staff) as a JSON graph.
model ChatbotFlow {
  id                String  @id @default(uuid()) @db.Uuid
  businessId        String  @db.Uuid
  whatsappAccountId String? @db.Uuid
  name              String
  /// {"start":"menu","nodes":{"menu":{"text":"...","options":[...]}}}
  definition        Json
  isActive          Boolean @default(false)
  version           Int     @default(1)

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, isActive])
  @@map("chatbot_flows")
}

/// Every WhatsApp/SMS/email message in or out: delivery & read reports, costs.
model MessageLog {
  id                String           @id @default(uuid()) @db.Uuid
  businessId        String           @db.Uuid
  channel           CampaignChannel
  direction         MessageDirection
  whatsappAccountId String?          @db.Uuid
  contactId         String?          @db.Uuid
  campaignId        String?          @db.Uuid
  automationRuleId  String?          @db.Uuid
  templateId        String?          @db.Uuid
  orderId           String?          @db.Uuid
  fromAddress       String?
  toAddress         String
  body              String?
  providerMessageId String?
  status            MessageStatus    @default(QUEUED)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  error             String?
  cost              Decimal?         @db.Decimal(10, 4)
  metadata          Json?

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount?  @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  contact         MarketingContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  automationRule  AutomationRule?   @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  template        MessageTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  order           StoreOrder?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([channel, providerMessageId])
  @@index([businessId, createdAt])
  @@index([campaignId, status])
  @@index([contactId, createdAt])
  @@map("message_logs")
}

// ============================================================
// DROPSHIPPING
// A supplier and a reseller are each an ABUUR business with a
// profile. Resellers list supplier products in their own store
// without holding stock; orders are routed to the supplier.
// ============================================================

enum SupplierStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum SupplierDocumentType {
  BUSINESS_LICENSE
  NATIONAL_ID
  TAX_CERTIFICATE
  BANK_LETTER
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupplierProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

enum ImportSource {
  MANUAL
  CSV
  API
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ResellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum SyncField {
  PRICE
  STOCK
  STATUS
  DETAILS
}

enum PromotionChannel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  OTHER
}

enum FulfillmentStatus {
  PENDING
  ACCEPTED
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

model SupplierProfile {
  id                           String         @id @default(uuid()) @db.Uuid
  businessId                   String         @unique @db.Uuid
  displayName                  String
  description                  String?
  phone                        String?
  whatsappNumber               String?
  email                        String?
  address                      String?
  city                         String?
  country                      String?        @default("SO")
  status                       SupplierStatus @default(PENDING)
  verifiedAt                   DateTime?
  verifiedById                 String?        @db.Uuid
  verificationNotes            String?
  /// Who handles what (the plan requires this to be explicit).
  handlesDelivery              Boolean        @default(true)
  handlesReturns               Boolean        @default(true)
  handlesCustomerCommunication Boolean        @default(false)
  /// e.g. {"leadTimeDays":2,"deliveryAreas":["Mogadishu"],"minOrder":1}
  fulfillmentTerms             Json?
  returnPolicy                 String?

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  verifiedBy   User?              @relation("SupplierVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  documents    SupplierDocument[]
  products     SupplierProduct[]
  importJobs   ProductImportJob[]
  fulfillments OrderFulfillment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("supplier_profiles")
}

/// Verification documents uploaded by a supplier and reviewed by ABUUR staff.
model SupplierDocument {
  id           String               @id @default(uuid()) @db.Uuid
  supplierId   String               @db.Uuid
  type         SupplierDocumentType
  fileId       String               @db.Uuid
  status       VerificationStatus   @default(PENDING)
  reviewedById String?              @db.Uuid
  reviewedAt   DateTime?
  notes        String?

  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  file       FileAsset       @relation(fields: [fileId], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("SupplierDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([supplierId, status])
  @@map("supplier_documents")
}

/// Supplier catalogue item with wholesale price and stock.
model SupplierProduct {
  id                   String                @id @default(uuid()) @db.Uuid
  supplierId           String                @db.Uuid
  sku                  String
  name                 String
  description          String?
  category             String?
  images               Json?
  /// e.g. {"size":["S","M"],"color":["Red"]}
  options              Json?
  wholesalePrice       Decimal               @db.Decimal(12, 2)
  suggestedRetailPrice Decimal?              @db.Decimal(12, 2)
  /// Resellers may not sell below this price.
  minRetailPrice       Decimal?              @db.Decimal(12, 2)
  currency             String                @default("USD")
  stock                Int                   @default(0)
  status               SupplierProductStatus @default(DRAFT)
  weightGrams          Int?
  /// Id in the supplier's own system when imported via API/CSV.
  externalId           String?
  lastSyncedAt         DateTime?

  supplier         SupplierProfile    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  resellerProducts ResellerProduct[]
  syncEvents       ProductSyncEvent[]
  orderItems       StoreOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, sku])
  @@index([status, category])
  @@map("supplier_products")
}

/// A bulk product import (CSV/API) and its outcome.
model ProductImportJob {
  id           String       @id @default(uuid()) @db.Uuid
  supplierId   String       @db.Uuid
  source       ImportSource @default(CSV)
  fileId       String?      @db.Uuid
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  failedRows   Int          @default(0)
  /// [{"row":12,"error":"price missing"}]
  errors       Json?
  createdById  String?      @db.Uuid
  startedAt    DateTime?
  completedAt  DateTime?

  supplier  SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  file      FileAsset?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("ProductImportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([supplierId, createdAt])
  @@map("product_import_jobs")
}

model ResellerProfile {
  id                   String         @id @default(uuid()) @db.Uuid
  businessId           String         @unique @db.Uuid
  status               ResellerStatus @default(PENDING)
  /// Used in promotion links and to attribute orders.
  referralCode         String         @unique
  defaultMarginPercent Decimal?       @db.Decimal(5, 2)
  approvedAt           DateTime?
  notes                String?

  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products       ResellerProduct[]
  commissions    ResellerCommission[]
  promotionLinks PromotionLink[]
  orders         StoreOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("reseller_profiles")
}

/// A supplier product listed in a reseller's store at the reseller's price.
/// `productId` is the real Product row shown on the storefront.
model ResellerProduct {
  id                String    @id @default(uuid()) @db.Uuid
  resellerId        String    @db.Uuid
  storeId           String    @db.Uuid
  supplierProductId String    @db.Uuid
  productId         String    @unique @db.Uuid
  sellingPrice      Decimal   @db.Decimal(12, 2)
  /// Wholesale price when listed/last synced; margin = sellingPrice - this.
  wholesalePrice    Decimal   @db.Decimal(12, 2)
  syncPrice         Boolean   @default(true)
  syncStock         Boolean   @default(true)
  isActive          Boolean   @default(true)
  lastSyncedAt      DateTime?

  reseller        ResellerProfile    @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct    @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotionLinks  PromotionLink[]
  syncEvents      ProductSyncEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, supplierProductId])
  @@index([resellerId, isActive])
  @@index([supplierProductId])
  @@map("reseller_products")
}

/// Product synchronisation and stock updates: every change pushed from a supplier product.
model ProductSyncEvent {
  id                String    @id @default(uuid()) @db.Uuid
  supplierProductId String    @db.Uuid
  resellerProductId String?   @db.Uuid
  field             SyncField
  oldValue          Json?
  newValue          Json?

  supplierProduct SupplierProduct  @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  resellerProduct ResellerProduct? @relation(fields: [resellerProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([supplierProductId, createdAt])
  @@map("product_sync_events")
}

/// Shareable promotion link; can open WhatsApp directly and attributes orders.
model PromotionLink {
  id                 String           @id @default(uuid()) @db.Uuid
  resellerId         String           @db.Uuid
  storeId            String?          @db.Uuid
  resellerProductId  String?          @db.Uuid
  code               String           @unique
  channel            PromotionChannel @default(WHATSAPP)
  targetUrl          String?
  /// WhatsApp order redirection: open chat with this prefilled text.
  redirectToWhatsApp Boolean          @default(false)
  whatsappMessage    String?
  isActive           Boolean          @default(true)
  expiresAt          DateTime?
  clickCount         Int              @default(0)
  orderCount         Int              @default(0)

  reseller        ResellerProfile  @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  store           Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  resellerProduct ResellerProduct? @relation(fields: [resellerProductId], references: [id], onDelete: Cascade)
  clicks          ReferralClick[]
  orders          StoreOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resellerId, isActive])
  @@map("promotion_links")
}

/// Referral tracking: one row per link visit (IP stored only as a hash).
model ReferralClick {
  id        String  @id @default(uuid()) @db.Uuid
  linkId    String  @db.Uuid
  ipHash    String?
  userAgent String?
  referrer  String?

  link PromotionLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())

  @@index([linkId, occurredAt])
  @@map("referral_clicks")
}

/// Order routing: the part of an order a supplier must fulfil.
model OrderFulfillment {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @db.Uuid
  supplierId     String            @db.Uuid
  status         FulfillmentStatus @default(PENDING)
  wholesaleTotal Decimal           @db.Decimal(12, 2)
  currency       String            @default("USD")
  carrier        String?
  trackingNumber String?
  notes          String?
  acceptedAt     DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  order       StoreOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier    SupplierProfile      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items       StoreOrderItem[]
  commissions ResellerCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, supplierId])
  @@index([supplierId, status])
  @@map("order_fulfillments")
}

/// Reseller commission tracking: what the reseller earns on an order.
model ResellerCommission {
  id            String           @id @default(uuid()) @db.Uuid
  resellerId    String           @db.Uuid
  orderId       String           @db.Uuid
  fulfillmentId String?          @db.Uuid
  amount        Decimal          @db.Decimal(12, 2)
  currency      String           @default("USD")
  status        CommissionStatus @default(PENDING)
  approvedAt    DateTime?
  paidAt        DateTime?
  /// Payout reference, e.g. mobile money transaction id (paid off-platform).
  reference     String?
  notes         String?

  reseller    ResellerProfile   @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  order       StoreOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillment OrderFulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, resellerId])
  @@index([resellerId, status])
  @@map("reseller_commissions")
}

// ============================================================
// WEBSITE CONTACT FORM
// Messages from the public website, read by ABUUR staff.
// ============================================================

enum ContactTopic {
  SALES
  SUPPORT
  PARTNERSHIP
  OTHER
}

enum ContactStatus {
  NEW
  HANDLED
  ARCHIVED
}

model ContactMessage {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String?
  phone        String?
  businessName String?
  topic        ContactTopic  @default(SALES)
  message      String
  locale       String        @default("so")
  status       ContactStatus @default(NEW)
  /// SHA-256 of the sender IP (salted); used only to spot abuse.
  ipHash       String?
  userAgent    String?
  handledAt    DateTime?
  handledById  String?       @db.Uuid

  handledBy User? @relation("ContactHandler", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}
