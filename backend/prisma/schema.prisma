// ============================================================
// AUTHENTICATION AND USERS
// ============================================================

model User {
  id                     String                @id @default(uuid()) @db.Uuid
  managedClients         CRMCustomer[]         @relation("ClientAccountManager")
  clientCommunications   ClientCommunication[] @relation("CommunicationAuthor")
  managedProjects        CreativeProject[]     @relation("ProjectManager")
  creativeReviews        CreativeReview[]      @relation("CreativeReviewer")
  verifiedSuppliers      SupplierProfile[]     @relation("SupplierVerifier")
  reviewedSupplierDocs   SupplierDocument[]    @relation("SupplierDocumentReviewer")
  productImports         ProductImportJob[]    @relation("ProductImportCreator")
  handledContactMessages ContactMessage[]      @relation("ContactHandler")
  supabaseId             String?               @unique
  passwordHash           String?
  email                  String?               @unique
  phone                  String?               @unique
  firstName              String?
  lastName               String?
  avatarUrl              String?
  status                 UserStatus            @default(ACTIVE)
  platformRole           PlatformRole          @default(OWNER)
  emailVerified          Boolean               @default(false)
  phoneVerified          Boolean               @default(false)

  memberships                    BusinessMembership[]
  createdStores                  Store[]                     @relation("StoreCreator")
  recordedBillings               SubscriptionBillingRecord[] @relation("BillingRecorder")
  orderStatusChanges             StoreOrderStatusEvent[]
  createdLeads                   Lead[]                      @relation("LeadCreator")
  assignedTasks                  CreativeTask[]              @relation("TaskAssignee")
  createdRequests                CreativeRequest[]           @relation("RequestCreator")
  financeEntries                 FinanceTransaction[]        @relation("FinanceCreator")
  notifications                  Notification[]
  createdNotificationCampaigns   NotificationCampaign[]      @relation("NotificationCampaignCreator")
  notificationDeliveryRecipients NotificationRecipient[]
  createdNotificationTemplates   NotificationTemplate[]      @relation("NotificationTemplateCreator")
  uploadedFiles                  FileAsset[]
  auditLogs                      AuditLog[]
  storeCustomers                 StoreCustomer[]
  sentInvitations                BusinessInvitation[]        @relation("InvitationInviter")
  assignedLeads                  Lead[]                      @relation("LeadAssignee")
  ownedDeals                     Deal[]                      @relation("DealOwner")
  createdDeals                   Deal[]                      @relation("DealCreator")
  dealStageChanges               DealStageChange[]           @relation("DealStageChanger")
  assignedCrmTasks               CrmTask[]                   @relation("CrmTaskAssignee")
  createdCrmTasks                CrmTask[]                   @relation("CrmTaskCreator")
  subscriptionEvents             ClientSubscriptionEvent[]   @relation("SubscriptionEventCreator")
  recordedPayments               Payment[]                   @relation("PaymentRecorder")
  projectMemberships             ProjectMember[]             @relation("ProjectMemberUser")
  projectComments                ProjectComment[]            @relation("ProjectCommentAuthor")
  createdCampaigns               Campaign[]                  @relation("CampaignCreator")
  inventoryChanges               InventoryMovement[]         @relation("InventoryMover")
  assignedOrders                 StoreOrder[]                @relation("OrderAssignee")
  reportExports                  ReportExport[]              @relation("ReportExporter")
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt

  @@index([status])
  @@map("users")
}

// ============================================================
// BUSINESSES AND MULTI-TENANCY
// ============================================================

model Business {
  id                   String                @id @default(uuid()) @db.Uuid
  clientOnboardings    ClientOnboarding[]
  servicePackages      ServicePackage[]
  clientSubscriptions  ClientSubscription[]
  clientCommunications ClientCommunication[]
  creativeDeliverables CreativeDeliverable[]
  whatsappAccounts     WhatsAppAccount[]
  contactSegments      ContactSegment[]
  messageTemplates     MessageTemplate[]
  automationRules      AutomationRule[]
  autoReplies          AutoReply[]
  chatbotFlows         ChatbotFlow[]
  messageLogs          MessageLog[]
  supplierProfile      SupplierProfile?
  resellerProfile      ResellerProfile?
  name                 String
  slug                 String                @unique
  description          String?
  logoUrl              String?
  email                String?
  phone                String?
  address              String?
  industry             String?
  status               BusinessStatus        @default(PENDING_APPROVAL)
  settings             Json?

  memberships          BusinessMembership[]
  subscriptions        Subscription[]
  billingRecords       SubscriptionBillingRecord[]
  stores               Store[]
  crmCustomers         CRMCustomer[]
  leads                Lead[]
  creativeRequests     CreativeRequest[]
  creativeProjects     CreativeProject[]
  marketingContacts    MarketingContact[]
  campaigns            Campaign[]
  financeEntries       FinanceTransaction[]
  invoices             Invoice[]
  payments             Payment[]
  integrations         IntegrationConnection[]
  files                FileAsset[]
  auditLogs            AuditLog[]
  roles                BusinessRole[]
  invitations          BusinessInvitation[]
  pipelines            Pipeline[]
  deals                Deal[]
  crmTasks             CrmTask[]
  financialCategories  FinancialCategory[]
  reportExports        ReportExport[]
  automationExecutions AutomationExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([industry])
  @@map("businesses")
}

model BusinessMembership {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  businessId   String           @db.Uuid
  role         MembershipRole   @default(EMPLOYEE)
  status       MembershipStatus @default(INVITED)
  invitedAt    DateTime?
  joinedAt     DateTime?
  /// Optional custom role: its module permissions replace the built-in role's defaults.
  customRoleId String?          @db.Uuid

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customRole BusinessRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([businessId, status])
  @@map("business_memberships")
}

/// A business-defined role. permissions = { "<module>": ["view","create","edit","delete","export","approve"] }
/// Modules: crm, creative, marketing, store, finance, files, reports, team, settings.
model BusinessRole {
  id          String  @id @default(uuid()) @db.Uuid
  businessId  String  @db.Uuid
  name        String
  description String?
  permissions Json

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships BusinessMembership[]
  invitations BusinessInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@map("business_roles")
}

/// Invite someone (who may not have an account yet) to join a business.
model BusinessInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  businessId   String           @db.Uuid
  email        String
  role         MembershipRole   @default(EMPLOYEE)
  customRoleId String?          @db.Uuid
  /// SHA-256 of the invitation token; the token itself is only shown once to the inviter.
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String?          @db.Uuid
  acceptedById String?          @db.Uuid
  acceptedAt   DateTime?

  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customRole BusinessRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  invitedBy  User?         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([email, status])
  @@map("business_invitations")
}

// ============================================================
// SUBSCRIPTIONS AND PLANS
// ============================================================

model Plan {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  description String?
  price       Decimal         @db.Decimal(12, 2)
  currency    String          @default("USD")
  interval    BillingInterval @default(MONTHLY)
  features    Json?
  limits      Json?
  isActive    Boolean         @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  planId                 String             @db.Uuid
  businessId             String             @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  startDate              DateTime           @default(now())
  endDate                DateTime?
  trialEndsAt            DateTime?
  nextBillingAt          DateTime?
  cancelledAt            DateTime?
  externalSubscriptionId String?
  metadata               Json?

  plan           Plan                        @relation(fields: [planId], references: [id])
  business       Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  billingRecords SubscriptionBillingRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([nextBillingAt])
  @@map("subscriptions")
}

model SubscriptionBillingRecord {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @db.Uuid
  businessId     String              @db.Uuid
  amount         Decimal             @db.Decimal(12, 2)
  currency       String              @default("USD")
  periodStart    DateTime
  periodEnd      DateTime
  status         BillingRecordStatus @default(PENDING)
  method         String?
  reference      String?
  notes          String?
  recordedById   String?             @db.Uuid
  paidAt         DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("BillingRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, periodStart])
  @@index([businessId, status])
  @@map("subscription_billing_records")
}

// ============================================================
// CRM
// ============================================================

model CRMCustomer {
  id               String                @id @default(uuid()) @db.Uuid
  status           ClientStatus          @default(LEAD)
  contactPerson    String?
  whatsappNumber   String?
  industry         String?
  website          String?
  city             String?
  country          String?
  socialLinks      Json?
  tags             String[]
  accountManagerId String?               @db.Uuid
  onboardedAt      DateTime?
  accountManager   User?                 @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  onboarding       ClientOnboarding?
  subscriptions    ClientSubscription[]
  communications   ClientCommunication[]
  projects         CreativeProject[]
  creativeRequests CreativeRequest[]
  businessId       String                @db.Uuid
  name             String
  email            String?
  phone            String?
  company          String?
  address          String?
  notes            String?
  metadata         Json?
  archivedAt       DateTime?

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads             Lead[]
  invoices          Invoice[]
  deals             Deal[]
  tasks             CrmTask[]
  payments          Payment[]
  files             FileAsset[]
  marketingContacts MarketingContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("crm_customers")
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  businessId        String     @db.Uuid
  customerId        String?    @db.Uuid
  createdById       String?    @db.Uuid
  title             String
  description       String?
  source            String?
  status            LeadStatus @default(NEW)
  value             Decimal?   @db.Decimal(12, 2)
  currency          String     @default("USD")
  expectedCloseDate DateTime?
  notes             String?
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  interest          String?
  /// 1 = highest, 5 = lowest
  priority          Int        @default(3)
  assignedToId      String?    @db.Uuid
  convertedAt       DateTime?
  lostReason        String?
  archivedAt        DateTime?

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   CRMCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?        @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  deals      Deal[]
  tasks      CrmTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([assignedToId])
  @@map("leads")
}

model Pipeline {
  id         String  @id @default(uuid()) @db.Uuid
  businessId String  @db.Uuid
  name       String
  isDefault  Boolean @default(false)

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stages   PipelineStage[]
  deals    Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@map("pipelines")
}

model PipelineStage {
  id          String  @id @default(uuid()) @db.Uuid
  pipelineId  String  @db.Uuid
  name        String
  sortOrder   Int     @default(0)
  /// Win probability 0-100, used for the weighted pipeline value.
  probability Int     @default(0)
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  pipeline    Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]
  changesFrom DealStageChange[] @relation("StageFrom")
  changesTo   DealStageChange[] @relation("StageTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, name])
  @@index([pipelineId, sortOrder])
  @@map("pipeline_stages")
}

model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  businessId        String     @db.Uuid
  pipelineId        String     @db.Uuid
  stageId           String     @db.Uuid
  customerId        String?    @db.Uuid
  leadId            String?    @db.Uuid
  ownerId           String?    @db.Uuid
  createdById       String?    @db.Uuid
  title             String
  value             Decimal    @default(0) @db.Decimal(12, 2)
  currency          String     @default("USD")
  expectedCloseDate DateTime?
  status            DealStatus @default(OPEN)
  closedAt          DateTime?
  lostReason        String?
  notes             String?

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pipeline  Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage     PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  customer  CRMCustomer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead      Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner     User?             @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("DealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  history   DealStageChange[]
  tasks     CrmTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([pipelineId, stageId])
  @@index([ownerId])
  @@map("deals")
}

model DealStageChange {
  id          String  @id @default(uuid()) @db.Uuid
  dealId      String  @db.Uuid
  fromStageId String? @db.Uuid
  toStageId   String  @db.Uuid
  changedById String? @db.Uuid
  note        String?

  deal      Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage PipelineStage? @relation("StageFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   PipelineStage  @relation("StageTo", fields: [toStageId], references: [id], onDelete: Cascade)
  changedBy User?          @relation("DealStageChanger", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
  @@map("deal_stage_changes")
}

/// Follow-ups, reminders and activities for customers, leads and deals.
model CrmTask {
  id           String     @id @default(uuid()) @db.Uuid
  businessId   String     @db.Uuid
  customerId   String?    @db.Uuid
  leadId       String?    @db.Uuid
  dealId       String?    @db.Uuid
  assignedToId String?    @db.Uuid
  createdById  String?    @db.Uuid
  title        String
  description  String?
  type         String     @default("FOLLOW_UP")
  status       TaskStatus @default(TODO)
  priority     Int        @default(3)
  dueAt        DateTime?
  completedAt  DateTime?
  remindedAt   DateTime?

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   CRMCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignedTo User?        @relation("CrmTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation("CrmTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status, dueAt])
  @@index([assignedToId, status])
  @@map("crm_tasks")
}

// ============================================================
// CREATIVE PRODUCTION
// ============================================================

model CreativeRequest {
  id             String                @id @default(uuid()) @db.Uuid
  customerId     String?               @db.Uuid
  objective      String?
  targetAudience String?
  platforms      String[]
  customer       CRMCustomer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId     String                @db.Uuid
  createdById    String                @db.Uuid
  title          String
  description    String?
  serviceType    String?
  requirements   Json?
  deadline       DateTime?
  status         CreativeRequestStatus @default(SUBMITTED)
  /// 1 = highest, 5 = lowest
  priority       Int                   @default(3)
  /// Dimensions / format, e.g. "1080x1080 Instagram post" or "30s vertical video".
  format         String?
  packageId      String?               @db.Uuid
  package        ServicePackage?       @relation(fields: [packageId], references: [id], onDelete: SetNull)

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User             @relation("RequestCreator", fields: [createdById], references: [id])
  project   CreativeProject?
  reviews   CreativeReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@map("creative_requests")
}

model CreativeProject {
  id                   String                @id @default(uuid()) @db.Uuid
  customerId           String?               @db.Uuid
  clientSubscriptionId String?               @db.Uuid
  managerId            String?               @db.Uuid
  stage                ProductionStage       @default(BRIEF)
  customer             CRMCustomer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientSubscription   ClientSubscription?   @relation(fields: [clientSubscriptionId], references: [id], onDelete: SetNull)
  manager              User?                 @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  deliverables         CreativeDeliverable[]
  reviews              CreativeReview[]
  businessId           String                @db.Uuid
  requestId            String?               @unique @db.Uuid
  title                String
  description          String?
  status               ProjectStatus         @default(PLANNING)
  startDate            DateTime?
  deadline             DateTime?
  completedAt          DateTime?
  revisionCount        Int                   @default(0)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  request  CreativeRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  tasks    CreativeTask[]
  members  ProjectMember[]
  comments ProjectComment[]
  files    FileAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@map("creative_projects")
}

model CreativeTask {
  id             String          @id @default(uuid()) @db.Uuid
  stage          ProductionStage @default(BRIEF)
  estimatedHours Decimal?        @db.Decimal(6, 2)
  projectId      String          @db.Uuid
  assignedToId   String?         @db.Uuid
  title          String
  description    String?
  status         TaskStatus      @default(TODO)
  priority       Int             @default(3)
  deadline       DateTime?
  completedAt    DateTime?
  parentId       String?         @db.Uuid

  project    CreativeProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  parent     CreativeTask?    @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   CreativeTask[]   @relation("Subtasks")
  comments   ProjectComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([assignedToId, status])
  @@index([parentId])
  @@map("creative_tasks")
}

/// Team members on a creative project (designers, editors, reviewers).
model ProjectMember {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  userId    String @db.Uuid
  role      String @default("DESIGNER")

  project CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectComment {
  id            String  @id @default(uuid()) @db.Uuid
  projectId     String  @db.Uuid
  taskId        String? @db.Uuid
  deliverableId String? @db.Uuid
  authorId      String? @db.Uuid
  /// Set when the comment came from a client through a review link.
  authorName    String?
  body          String
  /// Internal comments are never shown on client review links.
  isInternal    Boolean @default(true)

  project     CreativeProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        CreativeTask?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliverable CreativeDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  author      User?                @relation("ProjectCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_comments")
}

model CreativeReview {
  id            String               @id @default(uuid()) @db.Uuid
  projectId     String?              @db.Uuid
  deliverableId String?              @db.Uuid
  reviewedById  String?              @db.Uuid
  reviewerName  String?
  project       CreativeProject?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable   CreativeDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  reviewedBy    User?                @relation("CreativeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  requestId     String?              @db.Uuid
  status        ApprovalStatus       @default(PENDING)
  feedback      String?
  version       Int                  @default(1)
  reviewedAt    DateTime?

  request CreativeRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([requestId, status])
  @@map("creative_reviews")
}

// ============================================================
// WHATSAPP MARKETING AND SMS
// ============================================================

model MarketingContact {
  id              String                 @id @default(uuid()) @db.Uuid
  whatsappOptInAt DateTime?
  segmentMembers  ContactSegmentMember[]
  consentEvents   ContactConsentEvent[]
  messageLogs     MessageLog[]
  businessId      String                 @db.Uuid
  name            String?
  phone           String?
  email           String?
  tags            String[]
  whatsappConsent Boolean                @default(false)
  smsConsent      Boolean                @default(false)
  emailConsent    Boolean                @default(false)
  optedOutAt      DateTime?
  metadata        Json?
  /// Where the contact came from (import, storefront, form, manual, crm...).
  source          String?
  city            String?
  customerId      String?                @db.Uuid
  /// Last inbound WhatsApp message: free-form replies are only allowed within 24h of it.
  lastInboundAt   DateTime?

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   CRMCustomer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("marketing_contacts")
}

model Campaign {
  id                String           @id @default(uuid()) @db.Uuid
  segmentId         String?          @db.Uuid
  templateId        String?          @db.Uuid
  whatsappAccountId String?          @db.Uuid
  templateParams    Json?
  senderId          String?
  totalRecipients   Int              @default(0)
  sentCount         Int              @default(0)
  deliveredCount    Int              @default(0)
  readCount         Int              @default(0)
  failedCount       Int              @default(0)
  replyCount        Int              @default(0)
  clickCount        Int              @default(0)
  segment           ContactSegment?  @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  template          MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  messageLogs       MessageLog[]
  businessId        String           @db.Uuid
  name              String
  description       String?
  channel           CampaignChannel
  status            CampaignStatus   @default(DRAFT)
  message           String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  metadata          Json?
  createdById       String?          @db.Uuid
  /// Number of recipients skipped at send time (no consent / opted out).
  skippedCount      Int              @default(0)
  /// Sum of provider-reported costs (null when the provider gives no pricing).
  totalCost         Decimal?         @db.Decimal(12, 4)

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]
  createdBy  User?               @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id                String        @id @default(uuid()) @db.Uuid
  readAt            DateTime?
  failedAt          DateTime?
  repliedAt         DateTime?
  clickedAt         DateTime?
  campaignId        String        @db.Uuid
  contactId         String        @db.Uuid
  status            MessageStatus @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  error             String?
  attempts          Int           @default(0)

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ============================================================
// WHATSAPP STORE AND E-COMMERCE
// ============================================================

model Store {
  id               String            @id @default(uuid()) @db.Uuid
  resellerProducts ResellerProduct[]
  promotionLinks   PromotionLink[]
  businessId       String            @db.Uuid
  createdById      String            @db.Uuid
  name             String
  slug             String            @unique
  description      String?
  logoUrl          String?
  whatsappNumber   String?
  phone            String?
  email            String?
  address          String?
  city             String?
  status           StoreStatus       @default(DRAFT)
  currency         String            @default("USD")
  settings         Json?
  coverImageUrl    String?
  country          String?           @default("SO")
  /// { "facebook": "...", "instagram": "...", "tiktok": "..." }
  socialLinks      Json?
  /// { "delivery": "...", "returns": "...", "payment": "..." }
  policies         Json?

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy  User                @relation("StoreCreator", fields: [createdById], references: [id])
  products   Product[]
  categories ProductCategory[]
  inventory  InventoryMovement[]
  customers  StoreCustomer[]
  orders     StoreOrder[]
  domains    StoreDomain[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([businessId])
  @@index([status])
  @@map("stores")
}

model StoreDomain {
  id                String       @id @default(uuid()) @db.Uuid
  storeId           String       @db.Uuid
  domain            String       @unique
  isPrimary         Boolean      @default(false)
  isVerified        Boolean      @default(false)
  verifiedAt        DateTime?
  status            DomainStatus @default(PENDING)
  /// Value the owner must publish as a DNS TXT record at _abuur-verify.<domain>.
  verificationToken String?
  lastCheckedAt     DateTime?
  lastError         String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storeId])
  @@map("store_domains")
}

model ProductCategory {
  id          String  @id @default(uuid()) @db.Uuid
  storeId     String  @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int     @default(0)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("product_categories")
}

model Product {
  id                String           @id @default(uuid()) @db.Uuid
  resellerListing   ResellerProduct?
  storeId           String           @db.Uuid
  categoryId        String?          @db.Uuid
  name              String
  slug              String
  description       String?
  sku               String?
  price             Decimal          @db.Decimal(12, 2)
  compareAtPrice    Decimal?         @db.Decimal(12, 2)
  currency          String           @default("USD")
  stock             Int              @default(0)
  status            ProductStatus    @default(DRAFT)
  images            Json?
  metadata          Json?
  /// Internal cost: never returned by public storefront endpoints.
  costPrice         Decimal?         @db.Decimal(12, 2)
  lowStockThreshold Int              @default(5)
  trackInventory    Boolean          @default(true)
  allowBackorder    Boolean          @default(false)
  tags              String[]
  /// PHYSICAL or DIGITAL
  productType       String           @default("PHYSICAL")
  specifications    Json?

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems StoreOrderItem[]
  movements  InventoryMovement[]
  variants   ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId, status])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  name      String
  options   Json
  sku       String?
  price     Decimal? @db.Decimal(12, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  costPrice Decimal? @db.Decimal(12, 2)

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems StoreOrderItem[]
  movements  InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model InventoryMovement {
  id          String  @id @default(uuid()) @db.Uuid
  storeId     String  @db.Uuid
  productId   String  @db.Uuid
  quantity    Int
  reason      String
  referenceId String?
  notes       String?
  variantId   String? @db.Uuid
  createdById String? @db.Uuid
  /// Stock of the product (or variant) right after this movement.
  stockAfter  Int?

  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("InventoryMover", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model StoreCustomer {
  id       String  @id @default(uuid()) @db.Uuid
  storeId  String  @db.Uuid
  userId   String? @db.Uuid
  name     String
  phone    String?
  email    String?
  address  String?
  metadata Json?

  store  Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders StoreOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, phone])
  @@index([storeId, email])
  @@map("store_customers")
}

model StoreOrder {
  id                String               @id @default(uuid()) @db.Uuid
  resellerId        String?              @db.Uuid
  promotionLinkId   String?              @db.Uuid
  referralCode      String?
  reseller          ResellerProfile?     @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  promotionLink     PromotionLink?       @relation(fields: [promotionLinkId], references: [id], onDelete: SetNull)
  fulfillments      OrderFulfillment[]
  commissions       ResellerCommission[]
  messageLogs       MessageLog[]
  storeId           String               @db.Uuid
  customerId        String?              @db.Uuid
  orderNumber       String
  status            OrderStatus          @default(NEW)
  paymentStatus     PaymentStatus        @default(PENDING)
  subtotal          Decimal              @db.Decimal(12, 2)
  discount          Decimal              @default(0) @db.Decimal(12, 2)
  shippingCost      Decimal              @default(0) @db.Decimal(12, 2)
  total             Decimal              @db.Decimal(12, 2)
  currency          String               @default("USD")
  customerName      String?
  customerPhone     String?
  customerAddress   String?
  notes             String?
  paymentMethod     String?
  paymentNote       String?
  whatsappHandoffAt DateTime?
  metadata          Json?
  assignedToId      String?              @db.Uuid
  trackingNumber    String?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  paidAt            DateTime?

  store        Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     StoreCustomer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo   User?                   @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  items        StoreOrderItem[]
  statusEvents StoreOrderStatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@map("store_orders")
}

model StoreOrderItem {
  id                String            @id @default(uuid()) @db.Uuid
  supplierProductId String?           @db.Uuid
  fulfillmentId     String?           @db.Uuid
  wholesalePrice    Decimal?          @db.Decimal(12, 2)
  supplierProduct   SupplierProduct?  @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  fulfillment       OrderFulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)
  orderId           String            @db.Uuid
  productId         String?           @db.Uuid
  variantId         String?           @db.Uuid
  productName       String
  variantName       String?
  sku               String?
  quantity          Int
  unitPrice         Decimal           @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)

  order   StoreOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("store_order_items")
}

model StoreOrderStatusEvent {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?      @db.Uuid

  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("store_order_status_events")
}

// ============================================================
// FINANCE
// ============================================================

model FinanceTransaction {
  id                 String           @id @default(uuid()) @db.Uuid
  businessId         String           @db.Uuid
  createdById        String?          @db.Uuid
  type               TransactionType
  category           String
  description        String?
  amount             Decimal          @db.Decimal(12, 2)
  currency           String           @default("USD")
  reference          String?
  transactionDate    DateTime         @default(now())
  metadata           Json?
  categoryId         String?          @db.Uuid
  paymentMethod      String?
  status             FinanceTxStatus  @default(POSTED)
  /// A reversal points at the transaction it cancels (never edit posted money silently).
  reversalOfId       String?          @unique @db.Uuid
  receiptFileId      String?          @db.Uuid
  isRecurring        Boolean          @default(false)
  recurrenceInterval BillingInterval?
  nextOccurrenceAt   DateTime?
  /// Where the record came from, e.g. PAYMENT/<id> or STORE_ORDER/<id>; unique per business so
  /// the same payment or order is never counted twice.
  sourceType         String?
  sourceId           String?

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation("FinanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  categoryRef FinancialCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reversalOf  FinanceTransaction? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy  FinanceTransaction? @relation("Reversal")
  receiptFile FileAsset?          @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, sourceType, sourceId])
  @@index([businessId, type])
  @@index([businessId, transactionDate])
  @@index([isRecurring, nextOccurrenceAt])
  @@map("finance_transactions")
}

model FinancialCategory {
  id         String          @id @default(uuid()) @db.Uuid
  businessId String          @db.Uuid
  name       String
  type       TransactionType
  isActive   Boolean         @default(true)

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, type, name])
  @@map("financial_categories")
}

/// Record of every report export (who, what, when) — the file itself is generated on request.
model ReportExport {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @db.Uuid
  createdById String?      @db.Uuid
  reportType  String
  format      ReportFormat
  params      Json?
  status      ExportStatus @default(PENDING)
  rowCount    Int?
  error       String?
  completedAt DateTime?

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("ReportExporter", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("report_exports")
}

model Invoice {
  id                   String              @id @default(uuid()) @db.Uuid
  clientSubscriptionId String?             @db.Uuid
  clientSubscription   ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id], onDelete: SetNull)
  businessId           String              @db.Uuid
  customerId           String?             @db.Uuid
  invoiceNumber        String
  status               InvoiceStatus       @default(DRAFT)
  subtotal             Decimal             @db.Decimal(12, 2)
  tax                  Decimal             @default(0) @db.Decimal(12, 2)
  discount             Decimal             @default(0) @db.Decimal(12, 2)
  total                Decimal             @db.Decimal(12, 2)
  amountPaid           Decimal             @default(0) @db.Decimal(12, 2)
  currency             String              @default("USD")
  dueDate              DateTime?
  issuedAt             DateTime?
  notes                String?

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CRMCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  businessId           String        @db.Uuid
  invoiceId            String?       @db.Uuid
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("USD")
  status               PaymentStatus @default(PENDING)
  method               String?
  provider             String?
  reference            String?
  paidAt               DateTime?
  metadata             Json?
  kind                 PaymentKind   @default(PAYMENT)
  customerId           String?       @db.Uuid
  clientSubscriptionId String?       @db.Uuid
  /// For refunds and adjustments: the payment they correct.
  refundOfId           String?       @db.Uuid
  recordedById         String?       @db.Uuid
  dueDate              DateTime?
  receiptNumber        String?
  notes                String?

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer           CRMCustomer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientSubscription ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id], onDelete: SetNull)
  refundOf           Payment?            @relation("Refunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds            Payment[]           @relation("Refunds")
  recordedBy         User?               @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The same transaction reference can't be recorded twice in one business.
  @@unique([businessId, reference])
  @@unique([businessId, receiptNumber])
  @@index([businessId, status])
  @@index([invoiceId])
  @@index([customerId])
  @@map("payments")
}

