}

// ============================================================
// FILES AND MEDIA
// ============================================================

model FileAsset {
  id                String                @id @default(uuid()) @db.Uuid
  deliverables      CreativeDeliverable[]
  supplierDocuments SupplierDocument[]
  productImports    ProductImportJob[]
  businessId        String?               @db.Uuid
  uploadedById      String                @db.Uuid
  name              String
  originalName      String
  mimeType          String
  category          FileCategory          @default(OTHER)
