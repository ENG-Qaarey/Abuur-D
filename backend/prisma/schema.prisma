// ============================================================
// CRM, CLIENT SERVICES AND CREATIVE PRODUCTION
// ============================================================

model ClientOnboarding {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @db.Uuid
  customerId  String           @unique @db.Uuid
  status      OnboardingStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?

  business Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CRMCustomer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tasks    ClientOnboardingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@map("client_onboardings")
}

model ClientOnboardingTask {
  id           String    @id @default(uuid()) @db.Uuid
  onboardingId String    @db.Uuid
  title        String
  isDone       Boolean   @default(false)
  doneAt       DateTime?
  sortOrder    Int       @default(0)

  onboarding ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([onboardingId, sortOrder])
  @@map("client_onboarding_tasks")
}

model ServicePackage {
  id           String         @id @default(uuid()) @db.Uuid
  businessId   String         @db.Uuid
  name         String
  description  String?
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("USD")
  billing      PackageBilling @default(MONTHLY)
  deliverables Json?
  maxRevisions Int?
  isActive     Boolean        @default(true)
  /// Length of one term in days for ONE_TIME packages with a fixed duration (optional).
  durationDays Int?

  business               Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptions          ClientSubscription[]
  creativeRequests       CreativeRequest[]
  subscriptionEventsFrom ClientSubscriptionEvent[] @relation("EventFromPackage")
  subscriptionEventsTo   ClientSubscriptionEvent[] @relation("EventToPackage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, isActive])
  @@map("service_packages")
}

model ClientSubscription {
  id            String                   @id @default(uuid()) @db.Uuid
  businessId    String                   @db.Uuid
  customerId    String                   @db.Uuid
  packageId     String                   @db.Uuid
  status        ClientSubscriptionStatus @default(ACTIVE)
  price         Decimal                  @db.Decimal(12, 2)
  currency      String                   @default("USD")
  startDate     DateTime                 @default(now())
  endDate       DateTime?
  renewalDate   DateTime?
  autoRenew     Boolean                  @default(true)
  renewalCount  Int                      @default(0)
  lastRenewedAt DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  notes         String?

  remindedAt DateTime?

  business Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CRMCustomer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package  ServicePackage            @relation(fields: [packageId], references: [id])
  invoices Invoice[]
  projects CreativeProject[]
  events   ClientSubscriptionEvent[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([businessId, renewalDate])
  @@index([customerId])
  @@map("client_subscriptions")
}

/// History of a customer subscription: renewals, upgrades/downgrades, cancellations, reminders.
model ClientSubscriptionEvent {
  id             String                @id @default(uuid()) @db.Uuid
  subscriptionId String                @db.Uuid
  type           SubscriptionEventType
  fromPackageId  String?               @db.Uuid
  toPackageId    String?               @db.Uuid
  price          Decimal?              @db.Decimal(12, 2)
  note           String?
  createdById    String?               @db.Uuid

  subscription ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromPackage  ServicePackage?    @relation("EventFromPackage", fields: [fromPackageId], references: [id], onDelete: SetNull)
  toPackage    ServicePackage?    @relation("EventToPackage", fields: [toPackageId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("SubscriptionEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([subscriptionId, createdAt])
  @@map("client_subscription_events")
}

model ClientCommunication {
  id         String               @id @default(uuid()) @db.Uuid
  businessId String               @db.Uuid
  customerId String               @db.Uuid
  userId     String?              @db.Uuid
  channel    CommunicationChannel
  direction  MessageDirection     @default(OUTBOUND)
  subject    String?
  content    String
  occurredAt DateTime             @default(now())
  metadata   Json?

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CRMCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?       @relation("CommunicationAuthor", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([businessId, occurredAt])
  @@map("client_communications")
}

model CreativeDeliverable {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @db.Uuid
  projectId       String            @db.Uuid
  title           String
  version         Int               @default(1)
  status          DeliverableStatus @default(DRAFT)
  fileId          String?           @db.Uuid
  url             String?
  notes           String?
  deliveredAt     DateTime?
  submittedAt     DateTime?
  /// Marked final only after approval; final files get download links for the client.
  isFinal         Boolean           @default(false)
  /// SHA-256 of the client review link token (link valid until reviewDeadline / decision).
  reviewTokenHash String?           @unique
  reviewDeadline  DateTime?

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  CreativeProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file     FileAsset?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  reviews  CreativeReview[]
  comments ProjectComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, title, version])
  @@index([businessId, status])
  @@map("creative_deliverables")
}

