// ============================================================
// Prisma schema — ABUUR platform
// Generated for NestJS implementation
//
// Auth: Supabase Auth (supabaseId stored; passwords never stored for Supabase users)
// Local email+password users: scrypt hash in passwordHash (see src/auth/password.ts)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: Supabase shared transaction-mode pooler (aws-1-eu-west-3.pooler.supabase.com:6543, ?pgbouncer=true)
  url       = env("DATABASE_URL")
  // Migrations: shared session-mode pooler (aws-1-eu-west-3.pooler.supabase.com:5432); pgbouncer transaction mode can't run them
  directUrl = env("DIRECT_URL")
}

