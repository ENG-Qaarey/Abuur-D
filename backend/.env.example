# =============================================================================
#  ABUUR backend: environment template
#
#  Copy to .env and fill in the values:   cp .env.example .env
#  .env holds real secrets. It is git-ignored; never commit it or paste it into chats.
#  After changing anything here, restart the server (npm run start:dev).
# =============================================================================


# -----------------------------------------------------------------------------
#  Server
# -----------------------------------------------------------------------------
# development | production | test   (production turns off Swagger and
# enforces a strict CORS list)
NODE_ENV=development

# Port the API listens on: http://localhost:3000/api  (docs: /api/docs)
PORT=3000

# Browser origins allowed to call the API, comma-separated.
# "*" = any origin (dev only; refused when NODE_ENV=production).
# Example: http://localhost:3001,https://abuur.so
CORS_ORIGIN="*"

# Proxies allowed to set X-Forwarded-For (the real visitor IP, used for rate limits).
# loopback = the Next.js server on the same machine. Use your load balancer range in production.
TRUST_PROXY=loopback


# -----------------------------------------------------------------------------
#  Database: Supabase Postgres (Dashboard > Connect > ORMs > Prisma)
#  Special characters in the password must be URL-encoded (@ -> %40).
# -----------------------------------------------------------------------------
# Used by the running app: transaction pooler (port 6543).
# pgbouncer=true is required for this pooler; connection_limit caps
# connections per server instance.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Used only by Prisma migrations (npx prisma migrate deploy): session pooler (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
#  Authentication
# -----------------------------------------------------------------------------
# Signs the API's own access tokens. Must be long and random (min 32 chars).
# Changing it logs everyone out. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long an API access token is valid (e.g. 15m, 1h, 12h).
JWT_EXPIRES_IN=1h

# Supabase project URL. Login tokens are verified with its public keys:
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://<project-ref>.supabase.co

# Public (publishable) Supabase key. Safe in frontends; used by scripts/test-login.mjs.
SUPABASE_PUBLISHABLE_KEY=

# Only for old Supabase projects that sign with the legacy HS256 shared secret.
# Projects using the new signing keys (ES256/RS256) leave this empty.
SUPABASE_JWT_SECRET=


# -----------------------------------------------------------------------------
#  Background jobs: Redis / BullMQ (email, WhatsApp and SMS sending)
# -----------------------------------------------------------------------------
# false = no Redis needed: messages are sent inline (no retries, lost on restart).
# Fine for local development. Use true + a real Redis in production.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
#  Email: Resend (https://resend.com)
#  Empty API key = emails are skipped with a warning.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Sender address; its domain must be verified in Resend.
RESEND_FROM=noreply@abuur.so


# -----------------------------------------------------------------------------
#  WhatsApp Business Platform (Meta Cloud API)
#  Empty token or phone number id = WhatsApp messages are skipped with a warning.
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=


# -----------------------------------------------------------------------------
#  SMS provider
#  Empty API key = SMS is skipped with a warning. Fill in when a provider is chosen.
# -----------------------------------------------------------------------------
SMS_API_KEY=
SMS_API_URL=


# -----------------------------------------------------------------------------
#  Monitoring (optional)
# -----------------------------------------------------------------------------
# Sentry error tracking. Empty = disabled.
SENTRY_DSN=

# NestJS Observe telemetry. Empty = disabled.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=


# Seed (prisma/seed.ts). Required when NODE_ENV=production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
