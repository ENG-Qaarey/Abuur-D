# ABUUR Platform — Backend environment
# Copy to .env.local / .env and fill in your values.

# App
PORT=4000
API_PREFIX=api
NODE_ENV=development

# JWT (used for ABUUR's own access tokens issued after Supabase/local login)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Supabase Auth
SUPABASE_URL=https://xlwmxjrymlugpdzmcmew.supabase.co
# Dashboard -> Project Settings -> API Keys. The secret key is server-only: never commit it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://xlwmxjrymlugpdzmcmew.supabase.co/auth/v1/.well-known/jwks.json

# Database (Supabase Postgres)
# Runtime: shared transaction-mode pooler (port 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.xlwmxjrymlugpdzmcmew:[YOUR-DATABASE-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: shared session-mode pooler (port 5432)
DIRECT_URL="postgresql://postgres.xlwmxjrymlugpdzmcmew:[YOUR-DATABASE-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"

# CORS
CORS_ORIGIN=http://localhost:3001

# --- Five modules (2026-11-22) ---
# 64 hex chars; encrypts integration secrets (WhatsApp/Twilio tokens). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=
# Public URL of this API (for Twilio delivery callbacks), e.g. https://api.abuur.so/api
PUBLIC_API_URL=
# Web app URL used in invitation and client-review links
SITE_URL=http://localhost:3001
# Meta WhatsApp webhook (set the same values in the Meta app dashboard)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Files: "supabase" (private bucket, default when Supabase keys are set) or "local"
STORAGE_DRIVER=supabase
STORAGE_BUCKET=abuur-private
MAX_UPLOAD_MB=25
# Host that customer custom domains must CNAME to (leave empty until hosting supports it)
STORE_DOMAIN_TARGET=
# Background worker (campaigns, automations, reminders). Set true on extra API instances if wanted.
WORKER_DISABLED=false
