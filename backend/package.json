{
  "name": "abuut-backend",
  "version": "1.0.0",
  "description": "ABUUR platform backend — Express + Prisma (PostgreSQL/Supabase)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "prisma:generate": "prisma generate && node prisma/dump-datamodel.cjs",
    "postinstall": "prisma generate && node prisma/dump-datamodel.cjs",
    "deploy:cf": "wrangler deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "prisma": "^6.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.166.0"
  }
}
