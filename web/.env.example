# ABUUR web: copy to .env.local
# Base URL of the ABUUR Express API (includes the /api prefix). Server-side only.
ABUUR_API_URL=http://localhost:4000/api
# Public site URL (metadata, and the redirect target in Supabase auth emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase Auth: Dashboard -> Project Settings -> API Keys. Publishable key only, never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
