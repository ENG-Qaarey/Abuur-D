{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "abuur-d",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; must match the worker name above
			"binding": "WORKER_SELF_REFERENCE",
			"service": "abuur-d"
		}
	],
	"images": {
		// Next.js image optimization through Cloudflare Images
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// Backend API (Worker abuur-api, see backend/wrangler.jsonc)
		"ABUUR_API_URL": "https://abuur-api.muscabaxmed762.workers.dev/api",
		"NEXT_PUBLIC_SITE_URL": "https://abuur-d.muscabaxmed762.workers.dev"
	},
	"keep_vars": true
}
